{
    "name": "ianm/syndication",
    "description": "Brings RSS and Atom feeds to Flarum",
    "license": "CECILL-B",
    "type": "flarum-extension",
    "keywords": [
        "flarum"
    ],
    "support": {
        "issues": "https://github.com/imorland/syndication/issues",
        "source": "https://github.com/imorland/syndication",
        "forum": "https://discuss.flarum.org/d/27687"
    },
    "authors": [
        {
            "name": "Amaury Carrade",
            "email": "amaury@carrade.eu",
            "role": "Developer"
        },
        {
            "name": "IanM",
            "role": "Developer",
            "homepage": "https://discuss.flarum.org/u/ianm"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0"
    },
    "extra": {
        "flarum-extension": {
            "title": "Syndication",
            "category": "feature",
            "icon": {
                "name": "fas fa-rss",
                "backgroundColor": "#e28f12",
                "backgroundRepeat": "no-repeat",
                "backgroundPosition": "center",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/tags"
            ]
        },
        "flagrow": {
            "discuss": "https://discuss.flarum.org/d/27687"
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    },
    "autoload": {
        "psr-4": {
            "IanM\\FlarumFeeds\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IanM\\FlarumFeeds\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0.0",
        "flarum/tags": "^2.0.0",
        "flarum/testing": "^2.0.0"
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis",
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
